#!/bin/sh
img="$1"
[ -f "$img" ] || { notify-send "Nocturnal" "Wallpaper file not found: $img"; exit 1; }

target="$img"
case "$(printf '%s' "$img" | tr '[:upper:]' '[:lower:]')" in
    *.png) ;;
    *)
        target="/tmp/nocturnal-wall.png"
        if command -v magick >/dev/null 2>&1; then
            magick "$img" "$target"
        elif command -v ffmpeg >/dev/null 2>&1; then
            ffmpeg -y -i "$img" "$target" >/dev/null 2>&1
        else
            python3 -c 'from PIL import Image; import sys; Image.open(sys.argv[1]).save(sys.argv[2], "PNG")' "$img" "$target"
        fi
        [ -f "$target" ] || { notify-send "Nocturnal" "Could not convert wallpaper to PNG"; exit 1; }
        ;;
esac

pkill -x swaybg 2>/dev/null
nohup swaybg -i "$target" -m fill >/dev/null 2>&1 &
notify-send "Nocturnal" "Wallpaper set successfully"
