#!/bin/sh
command -v kitty >/dev/null 2>&1 || exit 0
acc="${1:-#c9b8ff}"
mode="${2:-dark}"
mkdir -p "$HOME/.config/kitty"
conf="$HOME/.config/kitty/kitty.conf"
[ -f "$conf" ] && [ ! -f "$conf.nocturnal-bak" ] && cp "$conf" "$conf.nocturnal-bak"
grep -qxF 'include nocturnal.conf' "$conf" 2>/dev/null \vert{}\vert{} printf '\ninclude nocturnal.conf\n' >> "$conf"

if [ "$mode" = "light" ]; then
    bg="#f3f1fa"; fg="#181924"; sfg="#ffffff"
else
    bg="#12131a"; fg="#e6e1ff"; sfg="#12131a"
fi

cat > "$HOME/.config/kitty/nocturnal.conf" << KCONF
background $bg
foreground $fg
background_opacity 0.78
dynamic_background_opacity yes
cursor $acc
selection_background $acc
selection_foreground $sfg
active_border_color $acc
KCONF
pkill -USR1 kitty 2>/dev/null || true
